# Supabase project URL and publishable/anon key are safe for browser use
# when Row Level Security is correctly enabled on every exposed table.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Never add the Supabase service-role key to a NEXT_PUBLIC variable.
# Bank provider secrets and AI API keys will be server-only variables when those
# integrations are implemented.
